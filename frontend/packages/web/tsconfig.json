{
  "extends": "../../tsconfig.json",
  "include": [
    "src/**/*",
    "types/**/*",
    "*.d.ts",
    "config/**/*"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["types/*"]
    },
    // 新增关键：moduleResolution，继承上层如果是classic就会炸vite插件类型
    "moduleResolution": "bundler",
    "module": "ESNext"
  }
}